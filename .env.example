# Direct token mode, one token per line/comma/semicolon.
REDMAGIC_ACCESS_TOKENS=

# Multi-account JSON mode.
# REDMAGIC_ACCOUNTS=[{"name":"main","access_token":"xxx"},{"name":"alt","access_token":"yyy"}]

# Daily task switches.
REDMAGIC_ENABLE_BOX=false
REDMAGIC_BOX_ONLY=false
REDMAGIC_BOX_PUSH_ONLY_OPENED=true
REDMAGIC_ENABLE_LOTTERY=true
REDMAGIC_LOTTERY_TIMES=10
REDMAGIC_LOTTERY_DELAY=1.5

# Push channels. Configure any one or more.
PUSHPLUS_TOKEN=
SCT_KEY=
BARK_KEY=
BARK_URL=
TG_BOT_TOKEN=
TG_USER_ID=
REDMAGIC_WEBHOOK_URL=

# Client tuning.
REDMAGIC_H5_VERSION=3.0.0

# Debug options.
REDMAGIC_DEBUG=false
REDMAGIC_DRY_RUN=false
REDMAGIC_FAIL_ON_ERROR=true
